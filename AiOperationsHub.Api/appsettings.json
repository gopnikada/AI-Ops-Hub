{
  "ConnectionStrings": {
    "DefaultConnection": "Server=IDEA;Database=AiOperationsHubDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "AiOperationsHub",
    "Audience": "AiOperationsHub.Api",
    "SigningKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "AI Operations Hub API"
    }
  },
  "Jira": {
    "BaseUrl": "https://gopnikada.atlassian.net",
    "Email": "klarsky.kirill6@gmail.com",
    "ApiToken": "your-jira-api-token",
    "DefaultProjectKey": "SCRUM",
    "TimeoutSeconds": 30
  },
  "OpenAi": {
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "your-openai-api-key",
    "Model": "gpt-5.1",
    "TimeoutSeconds": 60
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/",
    "ApiKey": "key",
    "Model": "gemini-3-flash-preview",
    "TimeoutSeconds": 60,
    "BudgetTokens": 1000000
  },
  "Anonymization": {
    "EnableStructuredAnonymization": true
  },
  "AllowedHosts": "*"
}